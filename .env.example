# Supabase
#
# SUPABASE_URL -> Project Overview > Project URL
# SUPABASE_SECRET_KEY -> Project Settings > API Keys > Secret keys
#
# nao coloque valores reais aqui, o .env com as credenciais
# verdadeiras nao deve ir pro git

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx

{
  "name": "concessionaria-api",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de uma concessionária de veículos - APS da disciplina de Back-End Development",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "back-end",
    "ts",
    "api",
    "concessionaria",
    "node"
  ],
  "license": "ISC",
  "author": "Leandro Augusto Alencar dos Santos, João Marcos da Guarda de Castro",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
